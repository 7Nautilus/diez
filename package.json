{
  "name": "diez",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jeu de questions coopératif à narrateur unique",
  "scripts": {
    "dev": "npm run compiler && vite",
    "build": "npm run compiler && tsc --noEmit && vite build",
    "compiler": "node tools/compiler.ts",
    "preview": "vite preview",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome ci .",
    "verifier": "node tools/verifier.mjs",
    "format": "biome format --write ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.11"
  }
}
